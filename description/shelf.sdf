          <contact><ode><kp>100000</kp><kd>10</kd><max_vel>1.0</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="right_v">
        <pose>0.2000 -0.1650 0.0750 0 0 0</pose>
        <geometry><box><size>0.3800 0.0100 0.1500</size></box></geometry>
        <material><ambient>0.15 0.35 0.8 1</ambient><diffuse>0.15 0.35 0.8 1</diffuse></material>
      </visual>
    </link>
    <joint name="drawer_2" type="prismatic">
      <parent>frame</parent>
      <child>bin_2_slider</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit><lower>-0.02</lower><upper>0.32</upper><effort>1000</effort><velocity>2.0</velocity></limit>
        <dynamics><damping>0.0</damping></dynamics>
      </axis>
    </joint>
    <joint name="bin_2_lift" type="prismatic">
      <parent>bin_2_slider</parent>
      <child>bin_2_lifter</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.15</lower><upper>0.1</upper><effort>1000</effort><velocity>2.0</velocity></limit>
        <dynamics><damping>0.0</damping></dynamics>
      </axis>
    </joint>
    <joint name="bin_2_tilt" type="revolute">
      <parent>bin_2_lifter</parent>
      <child>bin_2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.6</lower><upper>0.6</upper><effort>1000</effort><velocity>2.0</velocity></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>
    <!-- /shelf/joint_states: drawer_i = how far bin i moved out (m), bin_i_tilt = tilt (rad) -->
    <plugin name="shelf_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><namespace>/shelf</namespace></ros>
      <update_rate>20</update_rate>
        <joint_name>drawer_0</joint_name>
        <joint_name>bin_0_tilt</joint_name>
        <joint_name>drawer_1</joint_name>
        <joint_name>bin_1_tilt</joint_name>
        <joint_name>drawer_2</joint_name>
        <joint_name>bin_2_tilt</joint_name>
    </plugin>
  </model>
</sdf>
